<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Specurai.McpServer</AssemblyTitle>
    <Description>Specurai MCP Server - 透過 Model Context Protocol 查詢 SQL Server 資料庫結構、效能診斷與健康監控</Description>
    <!-- dotnet tool 設定 -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>specurai-mcp</ToolCommandName>
    <PackageId>Specurai.McpServer</PackageId>
    <Version>1.0.0</Version>
    <Authors>KerryHuang</Authors>
    <PackageProjectUrl>https://github.com/KerryHuang/DatabaseDescriptionApp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KerryHuang/DatabaseDescriptionApp</RepositoryUrl>
    <PackageTags>mcp;sql-server;database;model-context-protocol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../docs/McpServerREADME.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Specurai.Domain\Specurai.Domain.csproj" />
    <ProjectReference Include="..\Specurai.Application\Specurai.Application.csproj" />
    <ProjectReference Include="..\Specurai.Infrastructure\Specurai.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Specurai.McpServer.Tests" />
  </ItemGroup>

</Project>
