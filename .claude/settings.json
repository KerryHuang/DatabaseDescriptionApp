{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dotnet >/dev/null 2>&1 || exit 0; case \"${CLAUDE_TOOL_INPUT_FILE_PATH:-}\" in *.cs|*.csproj|*.sln) ;; *) exit 0 ;; esac; set -o pipefail; dotnet build \"$CLAUDE_PROJECT_DIR\" --no-restore --nologo -clp:ErrorsOnly 2>&1 | head -20; exit ${PIPESTATUS[0]:-$?}",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet publish:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet clean:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet tool install:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh run list:*)",
      "Bash(vpk pack:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(where:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Skill(superpowers:brainstorming)",
      "WebSearch",
      "WebFetch(domain:docs.avaloniaui.net)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)"
    ]
  }
}
