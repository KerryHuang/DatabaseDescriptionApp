<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Specurai.Desktop.ViewModels"
        xmlns:domain="using:Specurai.Domain.Entities"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="Specurai.Desktop.Views.ConnectionSetupWindow"
        x:DataType="vm:ConnectionSetupViewModel"
        Icon="/Assets/Specurai.png"
        Title="連線設定"
        Width="750" Height="700"
        MinWidth="650" MinHeight="580"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ConnectionSetupViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto" Margin="15">
        <!-- 主要內容區 -->
        <Grid Grid.Row="0" ColumnDefinitions="200,*">
            <!-- 左側：連線清單 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="10,8">
                        <TextBlock Text="連線設定檔" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="5" Margin="5">
                        <Button Content="新增" Command="{Binding NewProfileCommand}" Width="60"/>
                        <Button Content="刪除" Command="{Binding DeleteCommand}" Width="60"
                                IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel Margin="5" Spacing="4">
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:ConnectionProfile">
                                        <TextBlock Text="{Binding Converter={StaticResource ConnectionProfileDisplayConverter}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 外部連線群組，當已設定來源目錄時顯示 -->
                            <StackPanel IsVisible="{Binding IsSyncButtonVisible}">
                                <TextBlock Text="外部連線" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <ListBox ItemsSource="{Binding ExternalProfiles}"
                                         SelectedItem="{Binding SelectedExternalProfile}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="domain:ConnectionProfile">
                                            <TextBlock Text="{Binding Converter={StaticResource ConnectionProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右側：連線詳細設定 -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="10,8">
                        <TextBlock Text="連線資訊" FontWeight="SemiBold"/>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="15" Spacing="12">
                            <!-- 名稱 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="連線名稱"/>
                                <TextBox Text="{Binding Name}" Watermark="例如: 開發環境" IsReadOnly="{Binding IsExternalProfileSelected}"/>
                            </StackPanel>

                            <!-- 伺服器 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="伺服器"/>
                                <TextBox Text="{Binding Server}" Watermark="例如: localhost 或 192.168.1.100" IsReadOnly="{Binding IsExternalProfileSelected}"/>
                            </StackPanel>

                            <!-- 資料庫 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="資料庫名稱"/>
                                <TextBox Text="{Binding Database}" Watermark="例如: MyDatabase" IsReadOnly="{Binding IsExternalProfileSelected}"/>
                            </StackPanel>

                            <!-- 環境 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="環境"/>
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding EnvironmentOptions}"
                                          SelectedItem="{Binding Environment}"
                                          IsEnabled="{Binding !IsExternalProfileSelected}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DatabaseEnvironmentDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- 驗證方式 -->
                            <StackPanel Spacing="8" Margin="0,5,0,0">
                                <TextBlock Text="驗證方式"/>
                                <RadioButton GroupName="Auth" Content="Windows 驗證"
                                             IsChecked="{Binding UseWindowsAuth}"/>
                                <RadioButton GroupName="Auth" Content="SQL Server 驗證"
                                             IsChecked="{Binding UseWindowsAuth, Converter={x:Static BoolConverters.Not}}"/>
                            </StackPanel>

                            <!-- SQL Server 驗證欄位 -->
                            <StackPanel Spacing="10" IsVisible="{Binding UseWindowsAuth, Converter={x:Static BoolConverters.Not}}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="使用者名稱"/>
                                    <TextBox Text="{Binding Username}" IsReadOnly="{Binding IsExternalProfileSelected}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="密碼"/>
                                    <TextBox Text="{Binding Password}" PasswordChar="●" IsReadOnly="{Binding IsExternalProfileSelected}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 設為預設 -->
                            <CheckBox Content="設為預設連線" IsChecked="{Binding IsDefault}" Margin="0,5,0,0"/>

                            <!-- 測試連線 -->
                            <StackPanel Spacing="8" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="測試連線" Command="{Binding TestConnectionCommand}"
                                            IsEnabled="{Binding !IsTesting}"/>
                                    <ProgressBar IsIndeterminate="True" Width="80"
                                                 IsVisible="{Binding IsTesting}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TestResult}"
                                           Foreground="{Binding TestResult, Converter={StaticResource TestResultColorConverter}, FallbackValue=Gray}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部區域 -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,15,0,0">
            <!-- 外部來源設定 -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="外部來源設定" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="來源目錄" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExternalSourceDirectory}" Margin="0,0,4,4"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="瀏覽" Click="BrowseSourceDirectory_Click" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="金鑰檔" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExternalKeyFilePath}" Margin="0,0,4,4"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="BrowseKeyFile_Click" Margin="0,0,0,4"/>

                        <Button Grid.Row="2" Grid.Column="1" Content="儲存設定" HorizontalAlignment="Right"
                                Click="SaveExternalSettings_Click" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 同步按鈕與狀態 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="同步外部來源"
                        Command="{Binding SyncExternalSourceCommand}"
                        IsVisible="{Binding IsSyncButtonVisible}"
                        IsEnabled="{Binding !IsSyncing}"/>
                <TextBlock Text="{Binding SyncStatusMessage}"
                           IsVisible="{Binding SyncStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           VerticalAlignment="Center"
                           Margin="4,0"/>
            </StackPanel>

            <!-- 按鈕列 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="儲存" Command="{Binding SaveCommand}" Width="80"/>
                <Button Content="連線" Command="{Binding ConnectCommand}" Width="80"
                        IsEnabled="{Binding CanConnect}"/>
                <Button Content="關閉" Click="OnCloseClick" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
